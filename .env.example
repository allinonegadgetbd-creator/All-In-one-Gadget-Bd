# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this site is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Add in AI Studio Secrets & Hosting Env Vars)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: Restrict admin login to specific email(s) created in Supabase Auth (comma-separated)
ADMIN_EMAIL=

# Cloudinary Configuration (Server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional fallback Admin Passcode when Supabase Auth env vars are not configured
ADMIN_PASSCODE=
